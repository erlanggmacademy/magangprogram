---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { supabaseAdmin } from '../../../lib/supabase/admin';

const { data: settingsData } = await supabaseAdmin
  .from('site_settings')
  .select('*')
  .limit(1)
  .single();

const settings = settingsData || {};
---

<AdminLayout title="Pengaturan Website & Identitas" activeMenu="pengaturan">
  <div class="row g-4">
    <div class="col-lg-8">
      <div class="card-elegant p-4 p-md-5 bg-white border-0 shadow-sm">
        <h5 class="fw-bold text-maroon mb-4 font-heading border-bottom pb-3">Identitas & Kontak Organisasi</h5>

        <form id="settingsForm">
          <div class="row g-3">
            <div class="col-md-6">
              <label for="org_name" class="form-label fw-semibold small">Nama Brand / Organisasi</label>
              <input type="text" class="form-control" id="org_name" name="org_name" value={settings.org_name || ''} required />
            </div>

            <div class="col-md-6">
              <label for="whatsapp_number" class="form-label fw-semibold small">Nomor WhatsApp CTA Resmi</label>
              <div class="input-group">
                <span class="input-group-text bg-light text-muted">+</span>
                <input type="text" class="form-control" id="whatsapp_number" name="whatsapp_number" value={settings.whatsapp_number || '62895639068080'} required />
              </div>
              <div class="form-text">Gunakan format internasional tanpa spasi (contoh: 62895639068080).</div>
            </div>

            <div class="col-md-6">
              <label for="email" class="form-label fw-semibold small">Email Resmi</label>
              <input type="email" class="form-control" id="email" name="email" value={settings.email || ''} />
            </div>

            <div class="col-md-6">
              <label for="address" class="form-label fw-semibold small">Alamat Kantor / Wilayah</label>
              <input type="text" class="form-control" id="address" name="address" value={settings.address || ''} />
            </div>

            <div class="col-12">
              <label for="tagline" class="form-label fw-semibold small">Tagline Utama</label>
              <input type="text" class="form-control" id="tagline" name="tagline" value={settings.tagline || ''} />
            </div>

            <div class="col-12">
              <label for="description" class="form-label fw-semibold small">Deskripsi Ringkas Website</label>
              <textarea class="form-control" id="description" name="description" rows="3">{settings.description || ''}</textarea>
            </div>

            <div class="col-12 mt-4 pt-3 border-top">
              <h6 class="fw-bold text-maroon font-heading mb-3">Tautan Media Sosial</h6>
            </div>

            <div class="col-md-4">
              <label for="instagram_url" class="form-label fw-semibold small"><i class="bi bi-instagram me-1 text-danger"></i>Instagram URL</label>
              <input type="url" class="form-control" id="instagram_url" name="instagram_url" placeholder="https://instagram.com/..." value={settings.instagram_url || ''} />
            </div>

            <div class="col-md-4">
              <label for="linkedin_url" class="form-label fw-semibold small"><i class="bi bi-linkedin me-1 text-primary"></i>LinkedIn URL</label>
              <input type="url" class="form-control" id="linkedin_url" name="linkedin_url" placeholder="https://linkedin.com/..." value={settings.linkedin_url || ''} />
            </div>

            <div class="col-md-4">
              <label for="tiktok_url" class="form-label fw-semibold small"><i class="bi bi-tiktok me-1 text-dark"></i>TikTok URL</label>
              <input type="url" class="form-control" id="tiktok_url" name="tiktok_url" placeholder="https://tiktok.com/..." value={settings.tiktok_url || ''} />
            </div>

            <div class="col-12 mt-4 pt-3 border-top">
              <h6 class="fw-bold text-maroon font-heading mb-3">Default SEO Meta</h6>
            </div>

            <div class="col-12">
              <label for="default_meta_title" class="form-label fw-semibold small">Default Title SEO</label>
              <input type="text" class="form-control" id="default_meta_title" name="default_meta_title" value={settings.default_meta_title || ''} />
            </div>

            <div class="col-12">
              <label for="default_meta_description" class="form-label fw-semibold small">Default Meta Description</label>
              <textarea class="form-control" id="default_meta_description" name="default_meta_description" rows="2">{settings.default_meta_description || ''}</textarea>
            </div>
          </div>

          <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
            <button type="submit" id="btnSaveSettings" class="btn btn-maroon px-4 fw-bold">
              <span id="saveSettingsText">Simpan Pengaturan</span>
              <span id="saveSettingsSpinner" class="spinner-border spinner-border-sm d-none" role="status"></span>
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- Info Box -->
    <div class="col-lg-4">
      <div class="card-elegant p-4 bg-white border-0 shadow-sm mb-4">
        <h6 class="fw-bold text-maroon font-heading mb-3"><i class="bi bi-info-circle me-2"></i>Informasi Semi-CMS</h6>
        <p class="small text-muted mb-2">
          Seluruh data yang Anda ubah di halaman ini akan langsung tersinkronisasi ke tabel <code>site_settings</code> di Supabase.
        </p>
        <p class="small text-muted mb-0">
          Perubahan nomor WhatsApp akan langsung memengaruhi seluruh tombol CTA konsultasi dan floating button di seantero website.
        </p>
      </div>
    </div>
  </div>

  <script>
    const form = document.getElementById('settingsForm') as HTMLFormElement;
    const btn = document.getElementById('btnSaveSettings') as HTMLButtonElement;
    const btnText = document.getElementById('saveSettingsText') as HTMLElement;
    const btnSpinner = document.getElementById('saveSettingsSpinner') as HTMLElement;

    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();

        const formData = new FormData(form);
        const payload: Record<string, any> = {};
        formData.forEach((value, key) => {
          payload[key] = value.toString().trim();
        });

        btn.disabled = true;
        btnText.textContent = 'Menyimpan...';
        btnSpinner.classList.remove('d-none');

        try {
          const res = await fetch('/api/admin/settings/update', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });

          const data = await res.json();
          if (data.success) {
            alert('Pengaturan website berhasil disimpan!');
            window.location.reload();
          } else {
            alert(data.message || 'Gagal menyimpan pengaturan.');
            btn.disabled = false;
            btnText.textContent = 'Simpan Pengaturan';
            btnSpinner.classList.add('d-none');
          }
        } catch (err) {
          alert('Terjadi kesalahan jaringan.');
          btn.disabled = false;
          btnText.textContent = 'Simpan Pengaturan';
          btnSpinner.classList.add('d-none');
        }
      });
    }
  </script>
</AdminLayout>

