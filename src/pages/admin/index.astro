---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { supabaseAdmin } from '../../lib/supabase/admin';

// Query statistik pendaftar dari Supabase
const { data: allApps } = await supabaseAdmin
  .from('applications')
  .select('id, status, participant_type, created_at');

const apps = allApps || [];
const totalApps = apps.length;
const pendingApps = apps.filter(a => a.status === 'pending').length;
const reviewingApps = apps.filter(a => a.status === 'reviewing').length;
const acceptedApps = apps.filter(a => a.status === 'accepted').length;
const rejectedApps = apps.filter(a => a.status === 'rejected').length;
const smkApps = apps.filter(a => a.participant_type === 'smk').length;
const mhsApps = apps.filter(a => a.participant_type === 'mahasiswa').length;

// Query 5 pendaftar terbaru
const { data: recentAppsData } = await supabaseAdmin
  .from('applications')
  .select('id, application_number, full_name, institution, major, participant_type, status, created_at')
  .order('created_at', { ascending: false })
  .limit(5);

const recentApps = recentAppsData || [];

// Status styling helper
const getStatusBadge = (status: string) => {
  switch (status) {
    case 'pending': return 'badge bg-warning text-dark';
    case 'reviewing': return 'badge bg-info text-dark';
    case 'accepted': return 'badge bg-success';
    case 'rejected': return 'badge bg-danger';
    case 'withdrawn': return 'badge bg-secondary';
    default: return 'badge bg-secondary';
  }
};
---

<AdminLayout title="Ringkasan Dashboard" activeMenu="dashboard">
  <!-- STATS CARDS -->
  <div class="row g-3 mb-4">
    <!-- Card 1 -->
    <div class="col-xl-3 col-sm-6">
      <div class="card-elegant p-4 bg-white border-0 shadow-sm">
        <div class="d-flex justify-content-between align-items-center mb-2">
          <span class="text-muted small fw-semibold">Total Pendaftar</span>
          <div class="rounded-3 bg-accent-soft text-maroon p-2">
            <i class="bi bi-people-fill fs-5"></i>
          </div>
        </div>
        <h3 class="display-6 fw-bold text-maroon mb-1 font-heading">{totalApps}</h3>
        <span class="small text-muted">Seluruh calon peserta terdaftar</span>
      </div>
    </div>

    <!-- Card 2 -->
    <div class="col-xl-3 col-sm-6">
      <div class="card-elegant p-4 bg-white border-0 shadow-sm">
        <div class="d-flex justify-content-between align-items-center mb-2">
          <span class="text-muted small fw-semibold">Menunggu Review</span>
          <div class="rounded-3 bg-warning bg-opacity-25 text-dark p-2">
            <i class="bi bi-hourglass-split fs-5"></i>
          </div>
        </div>
        <h3 class="display-6 fw-bold text-warning text-dark mb-1 font-heading">{pendingApps}</h3>
        <span class="small text-muted">Perlu ditindaklanjuti</span>
      </div>
    </div>

    <!-- Card 3 -->
    <div class="col-xl-3 col-sm-6">
      <div class="card-elegant p-4 bg-white border-0 shadow-sm">
        <div class="d-flex justify-content-between align-items-center mb-2">
          <span class="text-muted small fw-semibold">Diterima Magang</span>
          <div class="rounded-3 bg-success bg-opacity-25 text-success p-2">
            <i class="bi bi-check-circle-fill fs-5"></i>
          </div>
        </div>
        <h3 class="display-6 fw-bold text-success mb-1 font-heading">{acceptedApps}</h3>
        <span class="small text-muted">Lolos tahap seleksi</span>
      </div>
    </div>

    <!-- Card 4 -->
    <div class="col-xl-3 col-sm-6">
      <div class="card-elegant p-4 bg-white border-0 shadow-sm">
        <div class="d-flex justify-content-between align-items-center mb-2">
          <span class="text-muted small fw-semibold">Komposisi Peserta</span>
          <div class="rounded-3 bg-secondary bg-opacity-25 text-secondary p-2">
            <i class="bi bi-pie-chart-fill fs-5"></i>
          </div>
        </div>
        <div class="d-flex align-items-baseline gap-2 mb-1">
          <span class="h4 fw-bold text-maroon mb-0">{smkApps}</span><small class="text-muted">SMK</small>
          <span class="text-muted">/</span>
          <span class="h4 fw-bold text-primary mb-0">{mhsApps}</span><small class="text-muted">Mhs</small>
        </div>
        <span class="small text-muted">Perbandingan jenjang</span>
      </div>
    </div>
  </div>

  <!-- RECENT APPLICATIONS TABLE -->
  <div class="card-elegant bg-white border-0 shadow-sm mb-4">
    <div class="card-header bg-white py-3 px-4 d-flex justify-content-between align-items-center border-bottom">
      <h5 class="fw-bold text-maroon mb-0 font-heading">Pendaftar Terbaru</h5>
      <a href="/admin/pendaftaran" class="btn btn-sm btn-maroon">
        Lihat Semua Pendaftar &rarr;
      </a>
    </div>

    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light small text-uppercase text-muted">
          <tr>
            <th class="ps-4">No. Registrasi</th>
            <th>Nama Lengkap</th>
            <th>Asal Institusi & Jurusan</th>
            <th>Kategori</th>
            <th>Status</th>
            <th>Tanggal Daftar</th>
            <th class="text-end pe-4">Aksi</th>
          </tr>
        </thead>
        <tbody class="small">
          {recentApps.length === 0 ? (
            <tr>
              <td colspan="7" class="text-center py-4 text-muted">
                Belum ada data pendaftar masuk.
              </td>
            </tr>
          ) : (
            recentApps.map(app => (
              <tr>
                <td class="ps-4 fw-bold text-maroon">{app.application_number}</td>
                <td class="fw-semibold">{app.full_name}</td>
                <td>
                  <div>{app.institution}</div>
                  <small class="text-muted">{app.major}</small>
                </td>
                <td>
                  <span class={`badge ${app.participant_type === 'smk' ? 'bg-maroon' : 'bg-primary'} text-uppercase`}>
                    {app.participant_type}
                  </span>
                </td>
                <td>
                  <span class={getStatusBadge(app.status)}>{app.status}</span>
                </td>
                <td class="text-muted">
                  {new Date(app.created_at).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' })}
                </td>
                <td class="text-end pe-4">
                  <a href={`/admin/pendaftaran?search=${app.application_number}`} class="btn btn-sm btn-outline-maroon py-1 px-2">
                    Detail
                  </a>
                </td>
              </tr>
            ))
          )}
        </tbody>
      </table>
    </div>
  </div>

  <!-- QUICK SHORTCUTS -->
  <div class="row g-3">
    <div class="col-md-4">
      <div class="card-elegant p-4 bg-white border-0 shadow-sm h-100 d-flex flex-column justify-content-between">
        <div>
          <h6 class="fw-bold text-maroon font-heading mb-2"><i class="bi bi-mortarboard me-2"></i>Kelola Program Magang</h6>
          <p class="text-muted small mb-3">Atur deskripsi, kurikulum, jurusan yang diterima, dan status publikasi program magang SMK & mahasiswa.</p>
        </div>
        <a href="/admin/program" class="btn btn-sm btn-outline-maroon">Buka Manajemen Program &rarr;</a>
      </div>
    </div>

    <div class="col-md-4">
      <div class="card-elegant p-4 bg-white border-0 shadow-sm h-100 d-flex flex-column justify-content-between">
        <div>
          <h6 class="fw-bold text-maroon font-heading mb-2"><i class="bi bi-briefcase me-2"></i>Kelola Layanan Agency</h6>
          <p class="text-muted small mb-3">Kelola tawaran jasa digital marketing, web dev, SEO, sosial media, dan desain grafis untuk klien bisnis.</p>
        </div>
        <a href="/admin/jasa" class="btn btn-sm btn-outline-maroon">Buka Layanan Jasa &rarr;</a>
      </div>
    </div>

    <div class="col-md-4">
      <div class="card-elegant p-4 bg-white border-0 shadow-sm h-100 d-flex flex-column justify-content-between">
        <div>
          <h6 class="fw-bold text-maroon font-heading mb-2"><i class="bi bi-gear me-2"></i>Pengaturan Website</h6>
          <p class="text-muted small mb-3">Ubah nama organisasi, nomor WhatsApp CTA (+62895639068080), logo, dan informasi kontak publik.</p>
        </div>
        <a href="/admin/pengaturan" class="btn btn-sm btn-outline-maroon">Buka Pengaturan &rarr;</a>
      </div>
    </div>
  </div>
</AdminLayout>

