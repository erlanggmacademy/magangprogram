---
import MainLayout from '../../layouts/MainLayout.astro';
import { supabase } from '../../lib/supabase/client';

const { data: categoriesData } = await supabase
  .from('portfolio_categories')
  .select('*');

const { data: portfoliosData } = await supabase
  .from('portfolios')
  .select('*, portfolio_categories(name)')
  .eq('is_published', true);

const categories = categoriesData || [];
const portfolios = portfoliosData || [];
---

<MainLayout
  title="Portofolio Hasil Proyek & Studi Kasus"
  description="Kumpulan hasil proyek digital agency dan karya magang terbaik: Website development, strategi SEO, kampanye sosial media, dan desain grafis."
>
  <div class="py-5 bg-white border-bottom">
    <div class="container text-center py-3">
      <span class="badge-maroon px-3 py-1 mb-2 d-inline-block">Karya & Proyek</span>
      <h1 class="display-5 fw-bold font-heading text-maroon mb-3">Portofolio & Studi Kasus</h1>
      <p class="lead text-muted mx-auto" style="max-width: 680px;">
        Bukti dedikasi kami dalam menghadirkan solusi digital berkualitas tinggi untuk klien dan hasil karya nyata para peserta program magang.
      </p>
    </div>
  </div>

  <section class="section-padding" style="background-color: #F8F6F5;">
    <div class="container">
      {portfolios.length === 0 ? (
        <div class="card-elegant p-5 text-center bg-white mx-auto" style="max-width: 600px;">
          <i class="bi bi-folder2-open display-3 text-muted mb-3 d-block"></i>
          <h4 class="fw-bold text-maroon mb-2">Belum Ada Proyek yang Ditampilkan</h4>
          <p class="text-muted small mb-4">
            Proyek sedang dalam tahap kurasi dan segera dipublikasikan melalui panel admin.
          </p>
          <a href="/jasa" class="btn btn-outline-maroon">Lihat Layanan Kami</a>
        </div>
      ) : (
        <div class="row g-4">
          {portfolios.map(p => (
            <div class="col-lg-4 col-md-6">
              <div class="card-elegant h-100 p-4 d-flex flex-column justify-content-between">
                <div>
                  <span class="badge bg-maroon text-white mb-2">{p.portfolio_categories?.name || 'Proyek'}</span>
                  <h5 class="fw-bold text-maroon mb-2 font-heading">{p.title}</h5>
                  <p class="text-muted small mb-3">{p.short_description}</p>
                </div>
                <div class="pt-3 border-top d-flex justify-content-between align-items-center">
                  <small class="text-muted">{p.client_name || 'Klien Internal'}</small>
                  {p.project_url && (
                    <a href={p.project_url} target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-maroon">
                      Live Demo <i class="bi bi-box-arrow-up-right ms-1"></i>
                    </a>
                  )}
                </div>
              </div>
            </div>
          ))}
        </div>
      )}
    </div>
  </section>
</MainLayout>

