---
import MainLayout from '../../layouts/MainLayout.astro';
import { supabase } from '../../lib/supabase/client';

const { data: postsData } = await supabase
  .from('blog_posts')
  .select('*, blog_categories(name)')
  .eq('status', 'published')
  .order('created_at', { ascending: false });

const { data: categoriesData } = await supabase
  .from('blog_categories')
  .select('*');

const posts = postsData || [];
const categories = categoriesData || [];
---

<MainLayout
  title="Blog & Wawasan Digital - Tips Magang & Artikel Edukasi"
  description="Kumpulan artikel edukatif, panduan magang SMK dan mahasiswa, strategi digital marketing, tips SEO, dan dunia pemrograman web."
>
  <div class="py-5 bg-white border-bottom">
    <div class="container text-center py-3">
      <span class="badge-maroon px-3 py-1 mb-2 d-inline-block">Artikel & Edukasi</span>
      <h1 class="display-5 fw-bold font-heading text-maroon mb-3">Blog & Panduan Magang</h1>
      <p class="lead text-muted mx-auto" style="max-width: 680px;">
        Pelajari berbagai wawasan industri, tips persiapan PKL/magang, tutorial web development, serta strategi digital marketing terkini.
      </p>
    </div>
  </div>

  <section class="section-padding" style="background-color: #F8F6F5;">
    <div class="container">
      {posts.length === 0 ? (
        <div class="card-elegant p-5 text-center bg-white mx-auto" style="max-width: 600px;">
          <i class="bi bi-journal-text display-3 text-muted mb-3 d-block"></i>
          <h4 class="fw-bold text-maroon mb-2">Artikel Sedang Disiapkan</h4>
          <p class="text-muted small mb-4">
            Artikel panduan magang dan edukasi digital akan segera diterbitkan melalui panel editor kami.
          </p>
          <a href="/program" class="btn btn-outline-maroon">Jelajahi Program Magang</a>
        </div>
      ) : (
        <div class="row g-4">
          {posts.map(post => (
            <div class="col-lg-4 col-md-6">
              <div class="card-elegant h-100 p-4 d-flex flex-column justify-content-between">
                <div>
                  <span class="badge bg-maroon text-white mb-2">{post.blog_categories?.name || 'Artikel'}</span>
                  <h5 class="fw-bold text-maroon mb-2 font-heading fs-6">{post.title}</h5>
                  <p class="text-muted small mb-3">{post.excerpt}</p>
                </div>
                <div class="pt-3 border-top d-flex justify-content-between align-items-center">
                  <small class="text-muted">{new Date(post.created_at).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' })}</small>
                  <a href={`/blog/${post.slug}`} class="text-maroon fw-semibold small text-decoration-none">
                    Baca Selengkapnya &rarr;
                  </a>
                </div>
              </div>
            </div>
          ))}
        </div>
      )}
    </div>
  </section>
</MainLayout>

