---
import { getAdminSession } from '../lib/auth';
import '../styles/global.css';

interface Props {
  title?: string;
  activeMenu?: string;
}

const { title = 'Admin Dashboard', activeMenu = 'dashboard' } = Astro.props;

// Auth guard
const adminUser = await getAdminSession(Astro.cookies);
if (!adminUser) {
  return Astro.redirect('/admin/login');
}

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Admin Portal Magang</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="bg-light">
    <div class="d-flex min-vh-100">
      
      <!-- SIDEBAR -->
      <aside class="bg-maroon-dark text-white d-flex flex-column flex-shrink-0 p-3 shadow-lg" style="width: 260px; z-index: 1000;">
        <!-- Brand -->
        <a href="/admin" class="d-flex align-items-center gap-2 mb-4 text-white text-decoration-none px-2">
          <span class="d-inline-flex align-items-center justify-content-center bg-white text-maroon rounded-3 p-2" style="width: 36px; height: 36px;">
            <i class="bi bi-mortarboard-fill fs-5"></i>
          </span>
          <div class="d-flex flex-column">
            <span class="fs-5 fw-bold font-heading lh-1">Admin<span class="text-warning">Portal</span></span>
            <small class="text-light opacity-50" style="font-size: 0.7rem;">Magang & Agency</small>
          </div>
        </a>

        <hr class="border-secondary opacity-25 my-1">

        <!-- Navigation Links -->
        <ul class="nav nav-pills flex-column mb-auto gap-1 mt-3">
          <li class="nav-item">
            <a href="/admin" class={`nav-link d-flex align-items-center gap-2 py-2 px-3 rounded-3 text-white ${activeMenu === 'dashboard' ? 'bg-maroon active fw-bold text-white shadow-sm' : 'opacity-75 hover-nav'}`}>
              <i class="bi bi-grid-1x2"></i>
              <span>Dashboard</span>
            </a>
          </li>

          <li class="nav-item">
            <a href="/admin/pendaftaran" class={`nav-link d-flex align-items-center gap-2 py-2 px-3 rounded-3 text-white ${activeMenu === 'pendaftaran' ? 'bg-maroon active fw-bold text-white shadow-sm' : 'opacity-75 hover-nav'}`}>
              <i class="bi bi-people"></i>
              <span>Data Pendaftar</span>
            </a>
          </li>

          <li class="nav-item">
            <a href="/admin/program" class={`nav-link d-flex align-items-center gap-2 py-2 px-3 rounded-3 text-white ${activeMenu === 'program' ? 'bg-maroon active fw-bold text-white shadow-sm' : 'opacity-75 hover-nav'}`}>
              <i class="bi bi-mortarboard"></i>
              <span>Program Magang</span>
            </a>
          </li>

          <li class="nav-item">
            <a href="/admin/jasa" class={`nav-link d-flex align-items-center gap-2 py-2 px-3 rounded-3 text-white ${activeMenu === 'jasa' ? 'bg-maroon active fw-bold text-white shadow-sm' : 'opacity-75 hover-nav'}`}>
              <i class="bi bi-briefcase"></i>
              <span>Layanan Jasa</span>
            </a>
          </li>

          <li class="nav-item">
            <a href="/admin/portofolio" class={`nav-link d-flex align-items-center gap-2 py-2 px-3 rounded-3 text-white ${activeMenu === 'portofolio' ? 'bg-maroon active fw-bold text-white shadow-sm' : 'opacity-75 hover-nav'}`}>
              <i class="bi bi-collection"></i>
              <span>Portofolio</span>
            </a>
          </li>

          <li class="nav-item">
            <a href="/admin/blog" class={`nav-link d-flex align-items-center gap-2 py-2 px-3 rounded-3 text-white ${activeMenu === 'blog' ? 'bg-maroon active fw-bold text-white shadow-sm' : 'opacity-75 hover-nav'}`}>
              <i class="bi bi-newspaper"></i>
              <span>Blog Artikel</span>
            </a>
          </li>

          <li class="nav-item mt-3 pt-2 border-top border-secondary border-opacity-25">
            <a href="/admin/pengaturan" class={`nav-link d-flex align-items-center gap-2 py-2 px-3 rounded-3 text-white ${activeMenu === 'pengaturan' ? 'bg-maroon active fw-bold text-white shadow-sm' : 'opacity-75 hover-nav'}`}>
              <i class="bi bi-gear"></i>
              <span>Pengaturan Web</span>
            </a>
          </li>
        </ul>

        <hr class="border-secondary opacity-25 my-3">

        <!-- User Profile & Logout -->
        <div class="px-2">
          <div class="d-flex align-items-center gap-2 mb-3">
            <div class="rounded-circle bg-warning text-dark d-flex align-items-center justify-content-center fw-bold" style="width: 38px; height: 38px;">
              {adminUser.full_name.charAt(0)}
            </div>
            <div class="d-flex flex-column overflow-hidden">
              <span class="small fw-bold text-truncate text-white">{adminUser.full_name}</span>
              <span class="badge bg-secondary bg-opacity-50 text-warning text-uppercase small" style="font-size: 0.65rem; width: fit-content;">{adminUser.role}</span>
            </div>
          </div>

          <div class="d-flex gap-2">
            <a href="/" target="_blank" class="btn btn-sm btn-outline-light w-50 py-1" title="Buka website publik">
              <i class="bi bi-box-arrow-up-right me-1"></i>Web
            </a>
            <button id="btnLogout" class="btn btn-sm btn-danger w-50 py-1" title="Keluar">
              <i class="bi bi-box-arrow-right me-1"></i>Logout
            </button>
          </div>
        </div>
      </aside>

      <!-- MAIN CONTENT -->
      <div class="flex-grow-1 d-flex flex-column min-vh-100 overflow-auto">
        <!-- Topbar -->
        <header class="bg-white border-bottom py-3 px-4 d-flex justify-content-between align-items-center shadow-sm">
          <h1 class="h5 fw-bold text-maroon mb-0 font-heading">{title}</h1>
          <div class="d-flex align-items-center gap-3">
            <span class="text-muted small d-none d-md-inline">Halo, <strong>{adminUser.full_name}</strong></span>
            <a href="/" target="_blank" class="btn btn-sm btn-outline-maroon d-flex align-items-center gap-1">
              <i class="bi bi-globe"></i>
              <span class="d-none d-sm-inline">Lihat Web Publik</span>
            </a>
          </div>
        </header>

        <!-- Body Content -->
        <main class="p-4 flex-grow-1">
          <slot />
        </main>
      </div>

    </div>

    <!-- Script Logout -->
    <script>
      const btnLogout = document.getElementById('btnLogout');
      if (btnLogout) {
        btnLogout.addEventListener('click', async () => {
          if (confirm('Apakah Anda yakin ingin keluar dari panel admin?')) {
            try {
              const res = await fetch('/api/auth/logout', { method: 'POST' });
              const data = await res.json();
              window.location.href = data.redirect || '/admin/login';
            } catch (e) {
              window.location.href = '/admin/login';
            }
          }
        });
      }
    </script>

    <!-- Bootstrap Bundle JS -->
    <script>
      import 'bootstrap/dist/js/bootstrap.bundle.min.js';
    </script>
  </body>
</html>

<style>
  .hover-nav:hover {
    opacity: 1 !important;
    background-color: rgba(255, 255, 255, 0.1);
  }
</style>

