---
const currentYear = new Date().getFullYear();
---

<footer class="bg-maroon-dark text-white pt-5 pb-4 mt-auto">
  <div class="container">
    <div class="row g-4 pb-4 border-bottom border-secondary border-opacity-25">
      <!-- Col 1: Brand Info -->
      <div class="col-lg-4 col-md-6">
        <div class="d-flex align-items-center gap-2 mb-3">
          <span class="d-inline-flex align-items-center justify-content-center bg-white text-maroon rounded-3 p-2" style="width: 38px; height: 38px;">
            <i class="bi bi-mortarboard-fill fs-5"></i>
          </span>
          <span class="fs-4 fw-bold font-heading text-white">Magang<span class="text-warning">&Agency</span></span>
        </div>
        <p class="text-light opacity-75 small pe-lg-4">
          Platform terpadu penyedia program magang & PKL untuk siswa SMK dan mahasiswa, serta agensi pemasaran digital, pengembangan web, SEO, dan branding profesional untuk bisnis.
        </p>
        <div class="d-flex gap-3 mt-3">
          <a href="#" class="btn btn-sm btn-outline-light rounded-circle d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;" aria-label="Instagram">
            <i class="bi bi-instagram"></i>
          </a>
          <a href="#" class="btn btn-sm btn-outline-light rounded-circle d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;" aria-label="LinkedIn">
            <i class="bi bi-linkedin"></i>
          </a>
          <a href="#" class="btn btn-sm btn-outline-light rounded-circle d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;" aria-label="TikTok">
            <i class="bi bi-tiktok"></i>
          </a>
        </div>
      </div>

      <!-- Col 2: Program Magang -->
      <div class="col-lg-2 col-md-6 col-6">
        <h6 class="text-uppercase text-warning fw-bold mb-3 fs-7 tracking-wide">Program SMK</h6>
        <ul class="list-unstyled small d-flex flex-column gap-2 mb-0 opacity-75">
          <li><a href="/program/magang-rpl" class="text-light text-decoration-none hover-link">Magang RPL</a></li>
          <li><a href="/program/magang-tkj" class="text-light text-decoration-none hover-link">Magang TKJ</a></li>
          <li><a href="/program/magang-multimedia" class="text-light text-decoration-none hover-link">Magang Multimedia</a></li>
          <li><a href="/program/magang-dkv" class="text-light text-decoration-none hover-link">Magang DKV</a></li>
          <li><a href="/program/magang-smk" class="text-light text-decoration-none hover-link">Tempat PKL SMK</a></li>
        </ul>
      </div>

      <!-- Col 3: Program Mahasiswa -->
      <div class="col-lg-3 col-md-6 col-6">
        <h6 class="text-uppercase text-warning fw-bold mb-3 fs-7 tracking-wide">Program Kuliah</h6>
        <ul class="list-unstyled small d-flex flex-column gap-2 mb-0 opacity-75">
          <li><a href="/program/magang-informatika" class="text-light text-decoration-none hover-link">Informatika & Web Dev</a></li>
          <li><a href="/program/magang-digital-marketing" class="text-light text-decoration-none hover-link">Digital Marketing</a></li>
          <li><a href="/program/magang-bisnis-digital" class="text-light text-decoration-none hover-link">Bisnis Digital & E-Commerce</a></li>
          <li><a href="/program/magang-pemasaran" class="text-light text-decoration-none hover-link">Manajemen Pemasaran</a></li>
          <li><a href="/program" class="text-light text-decoration-none hover-link">Seluruh Program Magang &rarr;</a></li>
        </ul>
      </div>

      <!-- Col 4: Layanan & Kontak -->
      <div class="col-lg-3 col-md-6">
        <h6 class="text-uppercase text-warning fw-bold mb-3 fs-7 tracking-wide">Layanan & Kontak</h6>
        <ul class="list-unstyled small d-flex flex-column gap-2 mb-3 opacity-75">
          <li><a href="/jasa/web-development" class="text-light text-decoration-none hover-link">Jasa Pembuatan Website</a></li>
          <li><a href="/jasa/seo" class="text-light text-decoration-none hover-link">Jasa SEO & Riset Keyword</a></li>
          <li><a href="/jasa/social-media-marketing" class="text-light text-decoration-none hover-link">Social Media Marketing</a></li>
          <li><a href="/jasa/branding" class="text-light text-decoration-none hover-link">Desain Grafis & Branding</a></li>
        </ul>
        <div class="pt-2">
          <a
            href="https://wa.me/62895639068080?text=Halo%20Admin%2C%20saya%20ingin%20bertanya%20informasi%20lengkap"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-sm btn-outline-warning text-white border-warning d-inline-flex align-items-center gap-2"
          >
            <i class="bi bi-whatsapp"></i> +62 895-6390-68080
          </a>
        </div>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="row pt-4 align-items-center small text-light opacity-75">
      <div class="col-md-6 text-center text-md-start mb-2 mb-md-0">
        <p class="mb-0">&copy; {currentYear} Program Magang & Digital Agency. All rights reserved.</p>
      </div>
      <div class="col-md-6 text-center text-md-end">
        <ul class="list-inline mb-0">
          <li class="list-inline-item"><a href="/kebijakan-privasi" class="text-light text-decoration-none">Kebijakan Privasi</a></li>
          <li class="list-inline-item">&bull;</li>
          <li class="list-inline-item"><a href="/syarat-ketentuan" class="text-light text-decoration-none">Syarat & Ketentuan</a></li>
          <li class="list-inline-item">&bull;</li>
          <li class="list-inline-item"><a href="/admin/login" class="text-light text-decoration-none opacity-50">Portal Admin</a></li>
        </ul>
      </div>
    </div>
  </div>
</footer>

<style>
  .hover-link:hover {
    color: #ffd166 !important;
    padding-left: 4px;
    transition: all 0.2s ease;
  }
</style>

