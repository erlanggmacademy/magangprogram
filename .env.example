# =====================================================================
# ENVIRONMENT VARIABLES - WEBSITE PROGRAM MAGANG & DIGITAL AGENCY
# =====================================================================

# URL Website (Gunakan localhost saat dev, ganti domain saat production)
PUBLIC_SITE_URL=http://localhost:4321

# Supabase API (Dapatkan dari Project Settings > API)
PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Supabase Service Role Secret Key (HANYA UNTUK SERVER/BACKEND, JANGAN BOCOR KE BROWSER)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Nomor WhatsApp Resmi (+62895639068080 tanpa tanda plus)
WHATSAPP_NUMBER=62895639068080

# Cloudflare Turnstile Spam Protection (Opsional di awal)
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

